APP_ENV=dev
APP_PORT=8080
APP_NAME=agent-server-go

MYSQL_DSN=root:root@tcp(mysql:3306)/agent?parseTime=true&charset=utf8mb4,utf8
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
MILVUS_ADDR=milvus:19530

LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3-coder-plus
LLM_HTTP_TIMEOUT_SECONDS=60
LLM_REQUEST_BUDGET_SECONDS=180
LLM_RETRY_MAX=5
LLM_RETRY_BACKOFF_MS=1500
LLM_MAX_CONTEXT_TOKENS=0

JWT_SECRET=change_me
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10
CHAT_MEMORY_MAX_MESSAGES=12
CHAT_MEMORY_TTL_SECONDS=1800

OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
